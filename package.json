{
  "name": "braze-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "./start.sh",
    "stop": "./stop.sh",
    "dev": "node scripts/watch-dev-server.mjs",
    "build": "tsc && vite build && node scripts/check-build-budgets.mjs",
    "build:player": "tsc && vite build --config vite.player.config.ts && node scripts/check-player-build-budgets.mjs",
    "check:player-build": "node scripts/check-player-build-budgets.mjs",
    "check:architecture": "npm run check:docs && node scripts/check-architecture.mjs",
    "check:types": "tsc --noEmit",
    "test": "npm run check:architecture && vitest run && node --test server/lib/*.test.mjs server/lib/assets/*.test.mjs server/routes/*.test.mjs scripts/lib/*.test.mjs tests/runtime-animation/*.test.mjs tests/runtime-characters/*.test.mjs tests/stock-controls/*.test.mjs",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:assets": "node --test server/lib/asset-index.test.mjs",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:player-browser": "npm run build:player && playwright test --config playwright.player.config.ts",
    "test:gameplay-browser": "playwright test --config playwright.gameplay.config.ts",
    "test:behavior-browser": "playwright test --config playwright.behaviors.config.ts",
    "test:destruction-browser": "playwright test --config playwright.destruction.config.ts",
    "test:runtime-browser": "node scripts/verify-runtime-browser.mjs",
    "verify:runtime": "npm run check:architecture && npm run check:types && npm test && npm run build && npm run test:soak && npm run test:runtime-browser",
    "review:runtime": "node scripts/review-runtime-lifecycle.mjs",
    "review:timing": "node scripts/review-runtime-lifecycle.mjs --timing",
    "review:entities": "node scripts/review-runtime-lifecycle.mjs --entities",
    "review:spawning": "node scripts/review-runtime-lifecycle.mjs --spawning",
    "review:pools": "node scripts/review-runtime-lifecycle.mjs --pools",
    "review:behaviors": "node scripts/review-runtime-lifecycle.mjs --behaviors",
    "test:animation-world-browser": "playwright test --config playwright.animation-world.config.ts",
    "test:runtime-animation-browser": "playwright test --config playwright.runtime-animation.config.ts",
    "test:runtime-characters-browser": "playwright test --config playwright.runtime-characters.config.ts",
    "test:stock-controls-browser": "playwright test --config playwright.stock-controls.config.ts",
    "test:input-assets-browser": "playwright test --config playwright.input-assets.config.ts",
    "test:models-browser": "playwright test --config playwright.models.config.ts",
    "review:models": "node scripts/review-runtime-lifecycle.mjs --models",
    "review:animation": "node scripts/review-runtime-lifecycle.mjs --animation",
    "review:runtime-animation": "node scripts/review-runtime-lifecycle.mjs --runtime-animation",
    "review:runtime-characters": "node scripts/review-runtime-lifecycle.mjs --runtime-characters",
    "review:stock-controls": "node scripts/review-runtime-lifecycle.mjs --stock-controls",
    "review:input-assets": "node scripts/review-runtime-lifecycle.mjs --input-assets",
    "review:destruction": "node scripts/review-runtime-lifecycle.mjs --destruction",
    "review:tags": "node scripts/review-runtime-lifecycle.mjs --tags",
    "review:prefabs": "node scripts/review-runtime-lifecycle.mjs --prefabs",
    "unity:register": "node scripts/register_unity_export.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:player": "vite preview --config vite.player.config.ts --host 127.0.0.1",
    "payloads:list": "find payloads -mindepth 1 -maxdepth 1 ! -name .gitkeep -print -exec du -sh {} \\;",
    "payloads:clean": "find payloads -mindepth 1 ! -name .gitkeep -exec rm -rf {} +",
    "models:list": "find models -mindepth 1 -maxdepth 1 ! -name .gitkeep -print -exec du -sh {} \\;",
    "create:game": "node scripts/create-game.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "sync:skill": "node scripts/sync-agent-skill.mjs",
    "test:scripting-browser": "playwright test --config playwright.scripting.config.mjs",
    "mcp": "node scripts/engine-mcp.mjs",
    "mcp:config": "node scripts/engine-mcp.mjs --config",
    "test:mcp-browser": "playwright test --config playwright.mcp.config.mjs",
    "test:ui-browser": "playwright test --config playwright.ui.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.70",
    "playwright": "^1.60.0",
    "terser": "5.51.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "description": "An experimental WebGPU game engine and editor for agent-led and manual authoring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/snack-gamer/braze-engine.git"
  },
  "bugs": {
    "url": "https://github.com/snack-gamer/braze-engine/issues"
  },
  "homepage": "https://github.com/snack-gamer/braze-engine#readme",
  "engines": {
    "node": ">=22.12.0"
  }
}
